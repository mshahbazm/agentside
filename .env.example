# ---- Server ----
PORT=3005
NODE_ENV=development

# ---- MongoDB (session persistence) ----
MONGODB_URI=mongodb://localhost:27017/agentside

# ---- Redis (rate limiting, shared infra) ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_USER=default
REDIS_TLS=false
REDIS_PREFIX=agentside:

# ---- Your app (the API the agent calls tools against) ----
PRIVATE_ATS_API_URL=http://localhost:3001
ATS_FRONTEND_URL=http://localhost:3000
ATS_ADMIN_URL=http://localhost:3002

# ---- Auth ----
# Secret used to verify the JWT your frontend passes over the WebSocket
AUTH_SECRET=change-me
# Service key the agent uses to call your API (server-to-server)
ATS_API_KEY=change-me

# ---- LLM (pi-ai selector: "provider/model-id") ----
LLM_MODEL=openai/gpt-4.1-mini
LLM_KEY=your-llm-provider-api-key

# ---- Optional tuning ----
# RATE_LIMIT_SOFT_MAX=20
# RATE_LIMIT_HARD_MAX=50
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_USER_SOFT_MAX=10
# RATE_LIMIT_USER_HARD_MAX=20
# RATE_LIMIT_USER_WINDOW_MS=60000
# EXECUTOR_REQUEST_TIMEOUT_MS=30000
# EXECUTOR_MAX_RETRIES=3
# VERBOSE_AGENT_LOG=false
