# ---- Server ----
PORT=3005
NODE_ENV=development

# ---- App identity ----
# Used in the system prompt: "You are the in-app AI assistant for <APP_NAME>"
APP_NAME=Acme CRM

# ---- MongoDB (session persistence) ----
MONGODB_URI=mongodb://localhost:27017/agentside

# ---- Redis (rate limiting) ----
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_USER=default
REDIS_TLS=false
REDIS_PREFIX=agentside:

# ---- Your app ----
# The API the agent calls tools against (server-to-server)
APP_API_URL=http://localhost:3001
# Service key sent as x-internal-key on every tool request
APP_API_KEY=change-me
# Comma-separated frontend origins allowed to connect (CORS + WebSocket)
CORS_ORIGINS=http://localhost:3000

# ---- Auth ----
# Secret used to verify the JWT your frontend presents at WebSocket upgrade
AUTH_SECRET=change-me

# ---- LLM (pi-ai selector: "provider/model-id") ----
LLM_MODEL=anthropic/claude-sonnet-4-6
LLM_KEY=your-llm-provider-api-key

# ---- Optional tuning ----
# RATE_LIMIT_SOFT_MAX=20
# RATE_LIMIT_HARD_MAX=50
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_USER_SOFT_MAX=10
# RATE_LIMIT_USER_HARD_MAX=20
# RATE_LIMIT_USER_WINDOW_MS=60000
# API_REQUEST_TIMEOUT_MS=30000
# API_MAX_RETRIES=3
# VERBOSE_AGENT_LOG=false
