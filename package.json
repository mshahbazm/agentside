{
  "name": "agentside",
  "version": "0.1.0",
  "description": "Self-hosted backend for an AI agent that lives inside your app and controls it through your own API.",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/types/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bunx tsc --build && bun run copy-llm-models",
    "copy-llm-models": "mkdir -p dist/llm/models && cp src/llm/models/*.json dist/llm/models/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@hono/node-ws": "^1.1.1",
    "@hono/zod-validator": "^0.7.5",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "croner": "^10.0.1",
    "dotenv": "^17.2.2",
    "gray-matter": "4.0.3",
    "hono": "^4.9.7",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "uuid": "^11.1.0",
    "typebox": "1.1.38",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
